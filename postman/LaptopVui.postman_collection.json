{
  "info": {
    "name": "Laptop Vui API v1",
    "description": "REST API JSON collection for Laptop Vui. Endpoints defined in PRD v1.0 Chapter 7.2.\n\nUsage:\n1. Set collection variable `base_url` to your target (e.g. http://localhost:8000 or https://laptop-vui-web.onrender.com)\n2. Run 'Auth > Login' first to populate {{token}} variable\n3. Other endpoints will auto-use Bearer token\n\nCLI: newman run LaptopVui.postman_collection.json --env-var base_url=http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "user_email", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hoten\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"matkhau\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 or 422', () => pm.expect([201, 422]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('user_email', pm.response.json().user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"matkhau\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns token', () => pm.expect(pm.response.json()).to.have.property('token'));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/products?page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('Has meta pagination', () => pm.expect(pm.response.json().meta).to.have.property('current_page'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/products/1", "host": ["{{base_url}}"], "path": ["api", "v1", "products", "1"] }
          }
        },
        {
          "name": "Get product 404",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/products/99999", "host": ["{{base_url}}"], "path": ["api", "v1", "products", "99999"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/orders", "host": ["{{base_url}}"], "path": ["api", "v1", "orders"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hoten\": \"Test User\",\n  \"email\": \"buyer@example.com\",\n  \"dienthoai\": \"0912345678\",\n  \"diachi\": \"123 Test St\",\n  \"items\": [\n    { \"id_sp\": 1, \"soluong\": 2 }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
